{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "web",
      "runtimeExecutable": "bun",
      "runtimeArgs": [
        "--cwd=web",
        "run",
        "dev",
        "--",
        "--port",
        "5173",
        "--strictPort"
      ],
      "port": 5173
    },
    {
      "name": "web-build",
      "runtimeExecutable": "bun",
      "runtimeArgs": ["--cwd=web", "./build"],
      "env": {
        "PORT": "4173",
        "PROTOCOL_HEADER": "x-forwarded-proto",
        "API_URL": "http://localhost:3000"
      },
      "port": 4173
    }
  ]
}
