# Where the /api proxy in src/hooks.server.ts sends requests.
API_URL=http://localhost:3000

# Port for the built server (bun ./build). Its default, 3000, clashes with the API.
PORT=4173

# The built server assumes https unless a header says otherwise. Locally, run it as
# PROTOCOL_HEADER=x-forwarded-proto PORT=4173 bun ./build
PROTOCOL_HEADER=x-forwarded-proto
